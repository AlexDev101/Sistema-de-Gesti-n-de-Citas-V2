# Copia este fichero a .env.local para desarrollo y pon los mismos valores en
# Netlify (Site configuration → Environment variables). Ver docs/INSTALACION.md.

# Supabase (Project Settings → API). La clave anon es pública: va al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto compartido servidor ↔ base. Tiene que ser EXACTAMENTE el valor de
# cron_secreto.secreto en la base. Sin él no se pueden crear reservas públicas
# ni enviar recordatorios. Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Resend (emails). Sin dominio verificado solo llegan a tu propio email.
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Barbería Ejemplo <citas@barberiaejemplo.es>"

# URL pública (enlaces de los emails, sitemap). En Netlify, si no la pones, se
# usa la variable URL que Netlify define sola.
# SITE_URL=https://www.barberiaejemplo.es

# Cloudflare Turnstile (captcha de la reserva). Opcional en desarrollo; muy
# recomendable en producción. https://dash.cloudflare.com → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
